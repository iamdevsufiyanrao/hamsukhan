{
    "name": "hamsukhan/connector",
    "description": "Receive bookings and orders captured by your Hamsukhan AI receptionist in any PHP or Laravel app.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Hamsukhan\\Connector\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hamsukhan\\Connector\\Laravel\\ConnectorServiceProvider"
            ]
        }
    }
}
